    return [f"/* ===== {label} ===== */"]


def read_source(path: Path) -> tuple[str, str]:
    data = path.read_bytes()
    for enc in ("utf-8-sig", "utf-8", "gb18030"):
        try:
            return data.decode(enc), enc
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", errors="replace"), "utf-8-replace"


def collect_source(root: Path, cfg: dict[str, Any], audit_dir: Path, submission_dir: Path) -> dict[str, Any]:
    files, rejected = list_source_files(root, cfg)
    lines: list[str] = []
    file_records: list[dict[str, Any]] = []
    for path in files:
        rel = path.resolve().relative_to(root.resolve()).as_posix()
        text, encoding = read_source(path)
        text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\x0c", "")
        body_lines = text.split("\n")
        while body_lines and body_lines[-1] == "":
            body_lines.pop()
        header = comment_header(rel, path.suffix)
        start = len(lines) + 1
        lines.extend(header)
        lines.extend(body_lines)
        end = len(lines)
        file_records.append(
            {
                "path": rel,
                "encoding": encoding,
                "sha256": sha256_file(path),
                "size_bytes": path.stat().st_size,
                "source_lines": len(body_lines),
                "merged_start_line": start,
                "merged_end_line": end,
            }
        )

    full_text = "\n".join(lines) + ("\n" if lines else "")
    audit_dir.mkdir(parents=True, exist_ok=True)
    full_path = audit_dir / "full-source.txt"
    full_path.write_text(full_text, encoding="utf-8")

    source_cfg = cfg.get("source", {})
    lines_per_page = int(source_cfg.get("lines_per_page", 50))
    max_pages = int(source_cfg.get("max_pages", 60))
    max_lines = lines_per_page * max_pages
    total = len(lines)
    if total > max_lines:
        front = max_lines // 2
        back = max_lines - front
        selected_lines = lines[:front] + lines[-back:]
        ranges = [
            {"full_start": 1, "full_end": front, "selected_start": 1, "selected_end": front},
            {
                "full_start": total - back + 1,
                "full_end": total,
                "selected_start": front + 1,
                "selected_end": max_lines,
            },
        ]
        strategy = "front-back"
    else:
        selected_lines = lines
        ranges = [
            {"full_start": 1, "full_end": total, "selected_start": 1, "selected_end": total}
        ] if total else []
        strategy = "all"

    selected_text = "\n".join(selected_lines) + ("\n" if selected_lines else "")
    submission_dir.mkdir(parents=True, exist_ok=True)
    selected_path = submission_dir / "source-code.txt"
    selected_path.write_text(selected_text, encoding="utf-8")

    manifest = {
        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "project_root": str(root.resolve()),
        "included_files": file_records,
        "rejected_files": rejected,
        "full_source": {
            "path": str(full_path.relative_to(audit_dir.parent)),
            "line_count": total,
            "sha256": sha256_text(full_text),
        },
        "selected_source": {
            "path": str(selected_path.relative_to(audit_dir.parent)),
            "line_count": len(selected_lines),
            "sha256": sha256_text(selected_text),
            "strategy": strategy,
            "ranges": ranges,
            "lines_per_page": lines_per_page,
            "max_pages": max_pages,
        },
    }
    save_json(audit_dir / "source-manifest.json", manifest)
    return manifest


def render_program_tex(skill_root: Path, cfg: dict[str, Any], submission_dir: Path, selected_lines: int) -> Path:
    template = (skill_root / "assets/templates/program-identification.tex.tpl").read_text(encoding="utf-8")
    software = cfg["software"]
    lines_per_page = int(get_nested(cfg, "source.lines_per_page", 50))
    pages = max(1, (selected_lines + lines_per_page - 1) // lines_per_page)
    blocks: list[str] = []
    for page in range(pages):
        start = page * lines_per_page + 1
        end = min((page + 1) * lines_per_page, max(selected_lines, 1))
        blocks.append(f"  \\codepage{{{start}}}{{{end}}}")
        if page != pages - 1:
            blocks.append("  \\newpage")
    text = (
        template.replace("@@SOFTWARE_NAME@@", latex_escape(software.get("full_name", "")))
        .replace("@@SOFTWARE_VERSION@@", latex_escape(software.get("version", "")))
        .replace("@@TOTAL_PAGES@@", str(pages))
        .replace("@@CODE_PAGES@@", "\n".join(blocks))
    )
    out = submission_dir / "程序鉴别材料.tex"
    out.write_text(text, encoding="utf-8")
    return out


def field_text(obj: dict[str, Any], key: str, fallback: str = "") -> str:
    value = obj.get(key, fallback)
    return latex_paragraph(value)


def screenshot_block(module: dict[str, Any], copied_path: str | None) -> str:
    name = latex_escape(module.get("name", "功能模块"))
    caption = latex_escape(module.get("caption") or f"{module.get('name', '功能模块')}界面")
    purpose = field_text(module, "purpose")
    operations = field_text(module, "operations")
    processing = field_text(module, "processing")
    desc_parts = []
    if purpose:
        desc_parts.append(f"该模块用于{purpose}。")
    if operations:
        desc_parts.append(f"用户可在该模块中完成{operations}。")
    if processing:
        desc_parts.append(f"系统会{processing}。")
    description = "".join(desc_parts) or "该模块用于完成软件的核心业务操作。"
    if copied_path:
        return (
            f"\\subsection{{{name}}}\n\n"
            f"\\screenshot{{{copied_path}}}{{{caption}}}{{\n{description}\n}}\n"
        )
    return (
        f"\\subsection{{{name}}}\n\n"
        f"\\screenshot{{images/missing-{latex_escape(str(module.get('_index', 0)))}.png}}{{{caption}}}{{\n{description}\n}}\n"
    )


def copy_screenshot(src: Path, dest: Path, grayscale: bool) -> dict[str, Any]:
    dest.parent.mkdir(parents=True, exist_ok=True)
    record: dict[str, Any] = {"source": str(src), "output": str(dest), "grayscale_requested": grayscale}
    if grayscale:
        try:
            from PIL import Image  # type: ignore

            with Image.open(src) as im:
                record.update({"width": im.width, "height": im.height, "source_mode": im.mode})
                converted = im.convert("L")
                converted.save(dest, format="PNG", optimize=True)
                record.update({"output_mode": "L", "converted": True})
                return record
        except Exception as exc:
            record["conversion_error"] = str(exc)
    shutil.copy2(src, dest)
    try:
        from PIL import Image  # type: ignore

        with Image.open(dest) as im:
            record.update({"width": im.width, "height": im.height, "output_mode": im.mode})
