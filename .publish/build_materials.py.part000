#!/usr/bin/env python3
"""Build Chinese software-copyright identification materials from a repository."""
from __future__ import annotations

import argparse
import fnmatch
import json
import os
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path, PurePosixPath
from typing import Any

from common import (
    command_exists,
    get_nested,
    latex_escape,
    latex_paragraph,
    load_config,
    run_command,
    save_json,
    sha256_file,
    sha256_text,
)

DEFAULT_EXTENSIONS = {
    ".py", ".pyi", ".go", ".java", ".kt", ".kts", ".c", ".h", ".cpp", ".hpp",
    ".cc", ".cs", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte", ".rs",
    ".swift", ".m", ".mm", ".php", ".rb", ".scala", ".dart", ".lua", ".sh",
    ".bash", ".zsh", ".ps1", ".sql", ".proto", ".graphql", ".html", ".css",
    ".scss", ".less",
}

DEFAULT_EXCLUDED_PARTS = {
    ".git", ".svn", ".hg", ".idea", ".vscode", "node_modules", "vendor", "vendors",
    "third_party", "third-party", "dist", "build", "out", "target", "coverage", ".next",
    ".nuxt", ".cache", ".venv", "venv", "env", "__pycache__", "migrations", "generated",
    "gen", "pb", "mock", "mocks", "fixtures", "testdata",
}

DEFAULT_EXCLUDED_FILES = {
    "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "go.sum", "Cargo.lock",
    "composer.lock", "Gemfile.lock", ".env", ".env.local", ".env.production",
}

GENERATED_MARKERS = (
    "code generated", "do not edit", "generated by", "auto-generated", "autogenerated",
    "this file was automatically generated", "protoc-gen-", "swagger codegen",
)

SECRET_FILE_PATTERNS = (
    re.compile(r"(^|/)\.env(?:\.|$)", re.I),
    re.compile(r"(^|/)(?:id_rsa|id_ed25519|private[_-]?key)(?:\.|$)", re.I),
    re.compile(r"\.(?:pem|p12|pfx|key)$", re.I),
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", required=True, type=Path, help="项目仓库根目录")
    parser.add_argument("--config", required=True, type=Path, help="JSON/YAML 配置文件")
    parser.add_argument("--output", type=Path, help="输出根目录；默认读取配置 output.directory")
    parser.add_argument("--mode", choices=("draft", "final"), default="final")
    parser.add_argument("--compile", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--validate", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--strict", action="store_true", help="校验时将警告视为失败")
    return parser.parse_args()


def matches_any(path: str, patterns: list[str]) -> bool:
    p = PurePosixPath(path)
    return any(fnmatch.fnmatch(path, pat) or p.match(pat) for pat in patterns)


def is_test_path(rel: str) -> bool:
    p = PurePosixPath(rel)
    parts = {part.lower() for part in p.parts}
    name = p.name.lower()
    return bool(parts & {"test", "tests", "__tests__", "spec", "specs"}) or bool(
        re.search(r"(?:^test_.*\.py$|_test\.go$|\.(?:test|spec)\.[^.]+$)", name)
    )


def git_tracked_files(root: Path) -> list[Path] | None:
    if not command_exists("git"):
        return None
    probe = run_command(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"], timeout=30)
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        return None
    proc = run_command(["git", "-C", str(root), "ls-files", "-z"], timeout=60)
    if proc.returncode != 0:
        return None
    return [root / x for x in proc.stdout.split("\0") if x]


def list_source_files(root: Path, cfg: dict[str, Any]) -> tuple[list[Path], list[dict[str, str]]]:
    source_cfg = cfg.get("source", {})
    extensions = {str(x).lower() for x in source_cfg.get("extensions", sorted(DEFAULT_EXTENSIONS))}
    include_globs = [str(x) for x in source_cfg.get("include_globs", [])]
    exclude_globs = [str(x) for x in source_cfg.get("exclude_globs", [])]
    exclude_tests = bool(source_cfg.get("exclude_tests", True))
    exclude_generated = bool(source_cfg.get("exclude_generated", True))
    max_bytes = int(source_cfg.get("max_file_bytes", 2_000_000))

    candidates = git_tracked_files(root)
    if candidates is None:
        candidates = [p for p in root.rglob("*") if p.is_file()]

    accepted: list[Path] = []
    rejected: list[dict[str, str]] = []
    for path in candidates:
        try:
            rel = path.resolve().relative_to(root.resolve()).as_posix()
        except Exception:
            rejected.append({"path": str(path), "reason": "outside-project"})
            continue
        p = PurePosixPath(rel)
        lower_parts = {part.lower() for part in p.parts}
        reason = ""
        if not path.is_file():
            reason = "not-file"
        elif any(rx.search(rel) for rx in SECRET_FILE_PATTERNS):
            reason = "secret-file"
        elif p.name in DEFAULT_EXCLUDED_FILES:
            reason = "excluded-file"
        elif lower_parts & DEFAULT_EXCLUDED_PARTS:
            reason = "excluded-directory"
        elif exclude_globs and matches_any(rel, exclude_globs):
            reason = "exclude-glob"
        elif include_globs and not matches_any(rel, include_globs):
            reason = "not-in-include-glob"
        elif path.suffix.lower() not in extensions:
            reason = "unsupported-extension"
        elif exclude_tests and is_test_path(rel):
            reason = "test-source"
        else:
            try:
                if path.stat().st_size > max_bytes:
                    reason = "too-large"
                else:
                    head = path.read_bytes()[:8192]
                    if b"\x00" in head:
                        reason = "binary"
                    elif exclude_generated:
                        text = head.decode("utf-8", errors="ignore").lower()
                        if any(marker in text for marker in GENERATED_MARKERS):
                            reason = "generated-source"
            except OSError:
                reason = "unreadable"
        if reason:
            rejected.append({"path": rel, "reason": reason})
        else:
            accepted.append(path)

    priority = [str(x) for x in source_cfg.get("priority_globs", [])]

    def sort_key(path: Path) -> tuple[int, int, str]:
        rel = path.resolve().relative_to(root.resolve()).as_posix()
        rank = next((i for i, pat in enumerate(priority) if matches_any(rel, [pat])), len(priority))
        return rank, len(PurePosixPath(rel).parts), rel.lower()

    accepted.sort(key=sort_key)
    return accepted, rejected


def comment_header(rel: str, suffix: str) -> list[str]:
    suffix = suffix.lower()
    label = f"File: {rel}"
    if suffix in {".py", ".pyi", ".rb", ".sh", ".bash", ".zsh", ".ps1"}:
        return [f"# ===== {label} ====="]
    if suffix in {".sql", ".lua"}:
        return [f"-- ===== {label} ====="]
    if suffix in {".html", ".xml", ".vue", ".svelte"}:
        return [f"<!-- ===== {label} ===== -->"]
